# FinRL-X-MT5 Environment Configuration
# Copy to .env and fill in your broker credentials
# DO NOT commit .env to version control

# MT5 Credentials (Optional if terminal is already open and logged in)
MT5__MT5_LOGIN=0
MT5__MT5_PASSWORD=
MT5__MT5_SERVER=
MT5__MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ─── MT5 Symbol Names ────────────────────────────────────────────────────────
# Broker symbols confirmed on active MT5 terminal:
# MT5__SYMBOLS=["NAS100.x", "WTI.x", "XAGUSD.x", "US30.x", "SPX500.x", "GER40.x", "JAP225.x", "UK100.x", "AUS200.x"]

# ─── Data API Keys ────────────────────────────────────────────────────────────
DATA__FMP_API_KEY=your_fmp_api_key_here

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── External Notifications (Telegram & Discord) ──────────────────────────────
# Trade signals are dispatched asynchronously from the Python Model Infrastructure
NOTIFICATIONS__ENABLE_NOTIFICATIONS=true
NOTIFICATIONS__NOTIFY_ON_TRADE=true
NOTIFICATIONS__NOTIFY_ON_CLOSE=true

# Discord Webhook:
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
NOTIFICATIONS__DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Telegram Bot:
# 1. Create bot with @BotFather -> get BOT_TOKEN
# 2. Add bot to your channel/group or message @userinfobot -> get CHAT_ID
NOTIFICATIONS__TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
NOTIFICATIONS__TELEGRAM_CHAT_ID=-1001234567890
