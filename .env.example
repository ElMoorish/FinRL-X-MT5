# FinRL-X-MT5 Environment Configuration
# Copy to .env and fill in your broker credentials
# DO NOT commit .env to version control

# MT5 Credentials (Optional if terminal is already open and logged in)
MT5__MT5_LOGIN=0
MT5__MT5_PASSWORD=
MT5__MT5_SERVER=
MT5__MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ─── MT5 Symbol Names ────────────────────────────────────────────────────────
# Broker symbols confirmed on active MT5 terminal:
# MT5__SYMBOLS=["NAS100.x", "WTI.x", "XAGUSD.x", "US30.x", "SPX500.x", "GER40.x", "JAP225.x", "UK100.x", "AUS200.x"]

# ─── Data API Keys ────────────────────────────────────────────────────────────
DATA__FMP_API_KEY=your_fmp_api_key_here

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
